# Skopíruj do .env.local a doplň hodnoty. .env.local sa necommituje.
# Premenné sa čítajú pri builde aj za behu servera; po zmene reštartuj dev server
# a v produkcii spusti nový build.

# ── Web ────────────────────────────────────────────────────────────────────────
# Verejná adresa (odkazy v e-mailoch, canonical URL, Open Graph, sitemap).
# Na Verceli sa bez nej použije VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=http://localhost:3000

# open = registrácia otvorená; waitlist = namiesto registrácie zápis na early access.
SIGNUP_MODE=open

# ── Úložisko a prihlasovanie ──────────────────────────────────────────────────
# Podpisuje cookie relácie a odkazy. V produkcii povinné: openssl rand -base64 32
AUTH_SECRET=

# Upstash Redis (Vercel → Storage → Upstash, premenné doplní integrácia).
# Bez nich: lokálne .data/store.json, v produkcii iba pamäť (dáta sa stratia).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mail s odkazom na nové heslo (Resend). Bez kľúča sa odkaz iba vypíše do logu.
RESEND_API_KEY=
EMAIL_FROM="PitchIt <onboarding@resend.dev>"

# Prihlásenie cez Google (voliteľné). Redirect URI:
# <NEXT_PUBLIC_SITE_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic (Claude): analýza podkladov, reporty, nápoveda, textový režim, cvičenia.
ANTHROPIC_API_KEY=
# Voliteľné: iný model (predvolený claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-sonnet-5-5

# OpenAI Realtime: živý hlasový rozhovor a prepis reči.
OPENAI_API_KEY=
# Voliteľné (predvolené hodnoty):
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_VOICE=cedar


# ── Platby (voliteľné) ────────────────────────────────────────────────────────
# Bez týchto premenných platby nie sú zapnuté a aplikácia to povie.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# ── Bezpečnosť a prevádzkovateľ ──────────────────────────────────────────────
# Tajomstvo na HMAC (hash IP pri limitoch, pseudonym používateľa pre poskytovateľa AI).
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Kontakt a prevádzkovateľ (pätička, právne stránky). Pred spustením povinné.
CONTACT_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ID=
LEGAL_ENTITY_ADDRESS=
ELEVENLABS_API_KEY=
